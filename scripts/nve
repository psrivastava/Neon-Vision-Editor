#!/bin/sh
set -u

app_name="Neon Vision Editor"

usage() {
    echo "Usage: nve [--wait] [--new-window] [--line N] [--column N] [file[:line[:col]] ...]" >&2
}

open_app() {
    if ! /usr/bin/open -a "$app_name" "$@"; then
        echo "nve: could not open $app_name" >&2
        exit 69
    fi
}

wait_flag=""
new_window_flag=""
line_number=""
column_number=""
paths=""

while [ "$#" -gt 0 ]; do
    arg="$1"
    case "$arg" in
        -h|--help)
            usage
            exit 0
            ;;
        -w|--wait)
            wait_flag="-W"
            shift
            continue
            ;;
        -n|--new-window)
            new_window_flag="-n"
            shift
            continue
            ;;
        -l|--line)
            shift
            if [ "$#" -eq 0 ]; then
                echo "nve: --line requires a line number" >&2
                exit 64
            fi
            line_number="$1"
            shift
            continue
            ;;
        --line=*)
            line_number="${arg#--line=}"
            shift
            continue
            ;;
        -c|--column)
            shift
            if [ "$#" -eq 0 ]; then
                echo "nve: --column requires a column number" >&2
                exit 64
            fi
            column_number="$1"
            shift
            continue
            ;;
        --column=*)
            column_number="${arg#--column=}"
            shift
            continue
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "nve: unknown option: $arg" >&2
            usage
            exit 64
            ;;
        *)
            break
            ;;
    esac
done

while [ "$#" -gt 0 ]; do
    arg="$1"
    if [ "$arg" = "--" ]; then
        shift
        continue
    fi

    # Support the file:line:col shorthand, but only when the literal path does not exist
    # (so real filenames containing colons still open correctly).
    if [ ! -e "$arg" ]; then
        case "$arg" in
            *:[0-9]*)
                base="${arg%%:*}"
                rest="${arg#*:}"
                if [ -e "$base" ]; then
                    # rest is line[:col]
                    line_part="${rest%%:*}"
                    case "$line_part" in
                        ''|*[!0-9]*) : ;;
                        *) line_number="$line_part" ;;
                    esac
                    case "$rest" in
                        *:*)
                            col_part="${rest#*:}"
                            case "$col_part" in
                                ''|*[!0-9]*) : ;;
                                *) column_number="$col_part" ;;
                            esac
                            ;;
                    esac
                    arg="$base"
                fi
                ;;
        esac
    fi

    if [ ! -e "$arg" ]; then
        echo "nve: file not found: $arg" >&2
        exit 66
    fi

    case "$arg" in
        /*) path="$arg" ;;
        *) path="$PWD/$arg" ;;
    esac

    paths="${paths}
$path"
    shift
done

if [ -n "$line_number" ]; then
    case "$line_number" in
        ''|*[!0-9]*)
            echo "nve: --line must be a positive integer" >&2
            exit 64
            ;;
    esac
fi

if [ -n "$column_number" ]; then
    case "$column_number" in
        ''|*[!0-9]*)
            echo "nve: --column must be a positive integer" >&2
            exit 64
            ;;
    esac
fi

if [ -z "$paths" ]; then
    # shellcheck disable=SC2086
    open_app $wait_flag $new_window_flag
    exit 0
fi

first_path=""
printf '%s\n' "$paths" | while IFS= read -r path; do
    if [ -z "$path" ]; then
        continue
    fi
    # shellcheck disable=SC2086
    open_app $wait_flag $new_window_flag "$path"
done

# After opening, if a line was requested, ask the app to place the cursor via its URL scheme.
# The app handles neonvisioneditor://goto?file=<abs>&line=N&column=N (ForkOpenLocation);
# older builds simply ignore the unknown URL, so the file still opens without cursor placement.
if [ -n "$line_number" ]; then
    first_path=$(printf '%s\n' "$paths" | while IFS= read -r p; do
        [ -n "$p" ] && { printf '%s' "$p"; break; }
    done)
    if [ -n "$first_path" ]; then
        enc_path=$(printf '%s' "$first_path" | /usr/bin/sed 's/ /%20/g')
        goto_url="neonvisioneditor://goto?file=${enc_path}&line=${line_number}&column=${column_number:-1}"
        /usr/bin/open "$goto_url" >/dev/null 2>&1 || true
    fi
fi
